{
    "name": "osticket/forte-parser",
    "description": "The osTicket-maintained Forte Blade and HTML parser with an AST toolkit and bounded HTML-only parsing.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "blade parser",
        "html parser",
        "ast"
    ],
    "homepage": "https://github.com/osTicket/forte-parser",
    "support": {
        "issues": "https://github.com/osTicket/forte-parser/issues",
        "source": "https://github.com/osTicket/forte-parser"
    },
    "authors": [
        {
            "name": "John Koster",
            "email": "john@stillat.com"
        },
        {
            "name": "osTicket",
            "homepage": "https://osticket.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10 || ^11 || ^12 || ^13",
        "illuminate/view": "^10 || ^11 || ^12 || ^13",
        "ext-dom": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.2 || ^10.0 || ^11.0",
        "pestphp/pest": "^2.0 || ^3",
        "laravel/pint": "^1.22",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1"
    },
    "conflict": {
        "fortephp/forte": "*"
    },
    "autoload": {
        "psr-4": {
            "Forte\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Forte\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.claude",
            "/.github",
            "/.idea",
            "/.phpstan.cache",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/composer.lock",
            "/phpstan.neon",
            "/phpunit.dist.xml",
            "/phpunit.xml",
            "/rector.php",
            "/tests",
            "/vendor"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Forte\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev"
}
